<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!--
    The library is what the conventions are asserted over. The Usage project is referenced for one type:
    PatternInfo, the reference reader. The reading rules are documented rather than implemented (ADR-0004),
    so that reader is their only executable statement — testing a copy of it here would test the copy.
  -->
  <ItemGroup>
    <ProjectReference Include="..\DesignPatternCatalog\DesignPatternCatalog.csproj" />
    <ProjectReference Include="..\DesignPatternCatalog.Usage\DesignPatternCatalog.Usage.csproj" />
  </ItemGroup>

</Project>
